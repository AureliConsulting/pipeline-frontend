# Local runner credentials — THIS FILE STAYS ON YOUR COMPUTER.
# Never upload it, never commit it, never paste values into the web app.
# The runner reads it via python-dotenv (config `env_file`, or the pipeline
# projects' own .env / API_keys.env files are picked up automatically).

# Pipeline 1 — sourcing & verification
VAYNE_API_KEY=your-vayne-key
ICYPEAS_API_KEY=your-icypeas-key
ICYPEAS_USER_ID=your-icypeas-user-id
MILLIONVERIFIER_API_KEY=your-millionverifier-key

# Pipeline 2 — GTM scoring & personalization
EXA_API_KEY=your-exa-key
DEEPSEEK_API_KEY=your-deepseek-key

# Optional — only needed for approved Instantly uploads
INSTANTLY_API_KEY=your-instantly-key

# Runner settings (optional)
# AURELI_SERVER_URL=https://your-app.vercel.app
