# Web application environment (local dev: apps/web/.env.local; production: Vercel).
# ONLY these three variables belong to the web app. Pipeline-provider keys
# (Vayne/Icypeas/MillionVerifier/Exa/DeepSeek/Instantly) must NEVER be set in
# Vercel or here — they live only on the runner machine.

# Public (safe for the browser bundle — anon key is protected by RLS):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Server-only (Vercel: mark as Sensitive; never NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...
